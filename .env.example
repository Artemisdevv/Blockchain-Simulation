# Copy to .env and fill in. Any var left unset here falls back to an
# interactive input() prompt when you run `python start_peer.py` - .env is
# for non-interactive runs (Docker, scripts), not required for normal local use.

# --- Peer identity ---
PEER_HOST=localhost
PEER_PORT=5000
PEER_NAME=alice

# --- Consensus ---
CONSENSUS=pos          # poa | pos | pow
DISK_LOAD=n            # y/n - load saved wallet/chain/peers from disk
DISK_SAVE=n            # y/n - persist to disk as state changes
MALICIOUS=n            # y/n - run as the malicious test node (mal_node.py)
STAKER=y               # y/n - pos only, ignored otherwise
MINER=y                # y/n - pow only, ignored otherwise

# --- Network join method: create | connect | room ---
ACTION=create

# connect: only used when ACTION=connect
BOOTSTRAP_HOST=
BOOTSTRAP_PORT=

# room: only used when ACTION=room (see signalling/server.py)
SIGNALLING_HOST=localhost
SIGNALLING_PORT=7000
ROOM_ID=

# --- Web API (webapi/server.py + webapi/events.py), pos peers only ---
# Defaults to 127.0.0.1 (safe for a bare machine). Set to 0.0.0.0 only
# inside a container reached solely via a published port - auth is
# still required either way. See docs/API.md.
WEBAPI_HOST=127.0.0.1

# Browser origins allowed to call Alice/Bob APIs in Docker Compose. For LAN
# or tunnel access, add the exact frontend origin (scheme, host, and port).
# Separate multiple origins with commas.
WEBAPI_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
